# 실행 환경: local / dev / prod
APP_ENV=local

# PostgreSQL (docker-compose 와 앱이 함께 사용)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=glowship
POSTGRES_PASSWORD=glowship
POSTGRES_DB=glowship

# 쿠키를 쓰는 CORS 는 "*" 를 허용하지 않으므로 프론트 오리진을 JSON 배열로 명시
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT 서명 키 (32바이트 이상 필수). 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-bytes
# 아래는 기본값이 있어 생략 가능
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Secure 쿠키 여부. 생략하면 APP_ENV=local 일 때만 false, 그 외 true
# COOKIE_SECURE=false
