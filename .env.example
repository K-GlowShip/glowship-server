# 실행 환경: local / dev / prod
APP_ENV=local

# 앱 로그 수준: DEBUG / INFO(기본) / WARNING / ERROR. 앱 로그만 바뀌고 라이브러리 로그는 WARNING 그대로. 비우면 INFO
# LOG_LEVEL=INFO

# PostgreSQL (docker-compose 와 앱이 함께 사용)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=glowship
POSTGRES_PASSWORD=glowship
POSTGRES_DB=glowship

# 수집 적재 전용 워커 DB 계정 (선택). 운영은 워커 역할(glowship_v4_worker)에 속한 로그인 계정을 넣는다.
# 둘 다 비우면 위 POSTGRES_USER·PASSWORD 로 붙는다(로컬 개발 DB). 하나만 넣으면 기동이 실패한다.
# 서버가 연결할 때 DB 역할을 glowship_v4_worker 로 바꾼다(RLS 가 역할 이름을 비교). 그 역할에 속하지 않은 계정이면 연결이 실패한다.
# WORKER_POSTGRES_USER=
# WORKER_POSTGRES_PASSWORD=

# 앱 연결의 DB 역할 고정 (선택, 이슈 #41). 운영은 POSTGRES_USER 에 앱 역할(glowship_v4_app)에 속한 로그인 계정을 넣고
# 이 값을 glowship_v4_app 으로 둔다. 서버가 연결할 때 역할을 바꾼다(RLS 가 역할 이름을 비교). 비우면 로그인 계정 그대로 붙는다(로컬).
# 넣으면 위 워커 계정도 넣어야 기동한다. 다른 값은 기동이 실패한다.
# POSTGRES_ROLE=

# 허용 오리진 목록 (JSON 배열). CORS 와 출처 검사(OriginCheck, CSRF 방어)가 함께 사용한다.
# - 쿠키를 쓰는 CORS 는 "*" 를 허용하지 않으므로 프론트 오리진을 명시
# - Swagger(/docs) 에서 POST 를 호출하려면 API 자신의 오리진(http://localhost:8000)도 포함
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# JWT 서명 키 (32자 이상 필수). 아래 예시 값은 일부러 짧게 두어 그대로 쓰면 기동이 실패합니다.
# 반드시 생성해서 넣으세요: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
# 아래는 기본값이 있어 생략 가능
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8시간. 개발 단계 프론트와 합의한 값
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Secure 쿠키 여부. 생략하면 APP_ENV=local 일 때만 false, 그 외 true
# COOKIE_SECURE=false

# 수집 멈춤 판정 배수. 마지막 수집 시작이 갱신 주기 × 배수보다 오래되면 동기화 안 됨(isSynced=false)으로 본다.
# 0 이면 판정하지 않는다. 합성데이터(2025년 이력)로 연동 데이터 화면을 확인할 때는 0 으로 둔다.
# SYNC_STALE_MULTIPLIER=2

# 가상 시각 시작 (데모). 기본값 2026-07-02T00:00:00Z. 수동 수집(API 25)은 마지막 적재 SHIPMENT 수집 날짜 + 1일 00:00Z 로 수집하고,
# 수집 현황 동기화 판정은 수집 멈춤(주기 × 배수)을 보지 않는다. 비우면 서버의 지금 시각을 쓴다.
# 실제 원천을 붙이는 환경(운영 배포)에서는 반드시 VIRTUAL_CLOCK_START= 로 비운다. 비우지 않으면 수집기가 멈춰도 동기화됨으로 보인다.
# VIRTUAL_CLOCK_START=2026-07-02T00:00:00Z

# 가상 TMS 시나리오 파일 경로 (수동 수집 API 25 의 SHIPMENT 응답). 비우면 0건 수집. 모양은 docs/data-sync/manual-sync.md
# VIRTUAL_TMS_SCENARIO_PATH=

# 가상 ERP·WMS 시나리오 파일 경로 (수동 동기화 API 25 의 주문·재고 응답, 가상 TMS 파일과 합쳐 읽음). 비우면 주문·재고 0건 수집
# VIRTUAL_ERP_WMS_SCENARIO_PATH=

# 데이터 팀 분석 엔진 폴더 (glowship_engine 과 synth2025_v5 가 함께 있는 폴더)
# 엔진 코드는 저장소에 넣지 않습니다. 공유 묶음 04_적재검증도구 에 glowship-plan tools/synth2025_v5 를 복사한 뒤 그 경로를 넣으세요.
# 비우면 엔진이 필요한 기능·시험이 동작하지 않습니다(시험은 건너뜀). docs/analysis/engine-local-path.md 참고
# 절대 경로를 넣으세요(상대경로·~ 는 엔진을 처음 부를 때의 실행 폴더·홈 폴더 기준으로 바뀝니다)
# GLOWSHIP_ENGINE_DIR=C:/path/to/00_필수_최신DB_전체재적재/04_적재검증도구

# 엔진 저장소 캐시 항목 수(고객사·입력 순번마다 하나, 하나에 0.3~0.5GB). 기본 2, 0 이면 캐시를 끔. docs/analysis/engine-store-cache.md
# 메모리 2GB 서버는 1. 0 은 같은 열쇠 동시 읽기 합치기도 꺼져 동시 실행 때 메모리가 오히려 늘어남. DB 를 다시 적재하면 서버 재시작
# ENGINE_STORE_CACHE_MAX_ENTRIES=2

# AI 설명을 만드는 모델 ("제공자/모델 ID"). 기본 mock/mock-template-v1 은 엔진의 결정적 mock 이라 외부 호출이 없습니다.
# 실제 모델(openai/…, gemini/…, anthropic/…, bedrock/…)은 엔진 등록부에 그 모델 설정이 있고 제공자 키가 있어야 합니다.
# 아니면 서버가 시작 단계에서 멈춥니다. 지금 엔진 판에는 mock 설정뿐입니다. docs/agent-flow/explanation.md 8절
# EXPLANATION_MODEL=mock/mock-template-v1

# 모델 호출 한 번의 시간 제한(초)과 설명 한 건(엔진 3시도 합)의 총 시간 예산(초)
# EXPLANATION_MODEL_TIMEOUT_SECONDS=12
# EXPLANATION_TOTAL_BUDGET_SECONDS=20

# 모델 제공자 API 키 (제공자마다 하나, 고른 제공자의 키만 필요). 저장소·이미지·로그에 넣지 않습니다.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# 실행 추적 내부 로그 폴더(분석 실행의 노드·도구·설명 시도, 주문 코드 등 마스킹). 비우면 추적하지 않습니다(기본)
# 폴더 아래 agent_trace_outbox/<고객사>/<UTC 날짜>.jsonl 에 남습니다. 서버 실행 사용자가 쓸 수 있는 폴더를 넣으세요
# (~·상대 경로는 설정을 읽을 때 홈 폴더·서버를 띄운 폴더 기준 절대 경로로 바뀝니다)
# 자동 시작을 켰을 때 쓸 수 없는 폴더면 서버 시작이 멈춥니다. docs/agent-flow/agent-tracing.md 3절
# AGENT_TRACE_DIR=C:/path/to/trace

# 분석 실행 하나의 시간 제한(초). 분석(시작~그래프 끝)을 넘으면 FAILED(RUN_TIME_LIMIT_EXCEEDED),
# 저장(재판정의 판정 서명 재계산 포함)을 넘으면 재계산 없이 다시 저장합니다. 값은 재측정(11-12)으로 정함. docs/analysis/auto-start.md 2절·7절 3번
# ANALYSIS_RUN_TIME_LIMIT_SECONDS=120
# ANALYSIS_SAVE_TIME_LIMIT_SECONDS=60

# 자동 시작(지연 감지·재분석으로 만든 실행을 서버 안에서 바로 분석·저장). 기본 꺼짐. 켜는 조건은 docs/analysis/auto-start.md 7절
# ANALYSIS_AUTO_START_ENABLED=false
# 한 서버 프로세스가 동시에 돌리는 분석 실행 수(기본 4). 메모리 2GB 서버는 1(서로 다른 순번 실행이 2건 이상 동시에 돌면 메모리 부족, 7절 3번)
# ANALYSIS_MAX_CONCURRENT_RUNS=4
